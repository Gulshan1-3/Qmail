# QuMail Environment Configuration Example
# Copy this file to .env and configure with your credentials.

# Logging
export QMAIL_LOG=info

# SMTP Configuration (e.g., Gmail smtp.gmail.com:587)
export QMAIL_SMTP_HOST="smtp.gmail.com"
export QMAIL_SMTP_PORT=587
export QMAIL_SMTP_USER="user@example.com"
export QMAIL_SMTP_PASS="your_app_password"

# IMAP Configuration (e.g., Gmail imap.gmail.com:993)
export QMAIL_IMAP_HOST="imap.gmail.com"
export QMAIL_IMAP_PORT=993
export QMAIL_IMAP_USER="user@example.com"
export QMAIL_IMAP_PASS="your_app_password"

# KME / QKD Configuration (ETSI GS QKD 014)
export QMAIL_KM_URL="https://127.0.0.1:13000"
export QMAIL_KM_IDENTITY_P12="./qkd_kme_server/client_identity.p12"
export QMAIL_KM_IDENTITY_PASSWORD="password"
export QMAIL_KM_CA_PEM="./qkd_kme_server/certs/root_ca_kmes_auth.crt"

# Security Association ID & SAE IDs
export QMAIL_SA_ID="alice-bob"
export QMAIL_SA_MASTER_ID=1
export QMAIL_SA_SLAVE_ID=2
